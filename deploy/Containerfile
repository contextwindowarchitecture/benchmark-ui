# The results site's image (benchmark-ui's plan, 12.1): a Node stage builds the app, and the UBI nginx image serves
# it unprivileged on 8080 under any UID with GID 0, as OpenShift's restricted profile requires. Results are never in
# the image: they are a volume at /data/results (deploy/base/deployment.yaml), and config.json comes from a
# ConfigMap. Build from the repository root:
#   podman build -f deploy/Containerfile -t quay.io/contextwindowarchitecture/benchmark-ui:dev .
FROM docker.io/library/node:24-bookworm-slim AS build
WORKDIR /src
COPY package.json pnpm-lock.yaml ./
# pnpm at the version package.json pins. Its store and metadata cache live in build cache mounts, not in the
# image's layers, so a rebuild reuses them and the build stage stays small.
RUN --mount=type=cache,target=/root/.local/share/pnpm,sharing=locked \
    --mount=type=cache,target=/root/.cache/pnpm,sharing=locked \
    npm install -g "pnpm@$(node -p "require('./package.json').packageManager.split('@')[1]")" \
    && pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM registry.access.redhat.com/ubi9/nginx-124:latest
# The built app at the image's document root, and the server configuration in the default server's include
# directory (the cluster mounts the same files from a ConfigMap over it). An empty results directory to mount over.
COPY --from=build /src/dist/ /opt/app-root/src/
COPY deploy/base/nginx/benchmark-ui.conf deploy/base/nginx/headers.inc /opt/app-root/etc/nginx.default.d/
USER 0
RUN mkdir -p /data/results && chown -R 1001:0 /data && chmod -R g+rwX /data
USER 1001
EXPOSE 8080
CMD ["/usr/libexec/s2i/run"]
